{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://rumble-os-backend.onrender.com/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

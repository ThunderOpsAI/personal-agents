{
  "crons": [
    {
      "path": "/api/v1/retrieval/scan?cron=true",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}


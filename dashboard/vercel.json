    {
      "path": "/api/v1/pain/notify",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/v1/pain/notify",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/v1/pain/notify",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/v1/pain/notify",
      "schedule": "0 6 * * *"
    },
    {

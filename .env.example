# ─── LLM Provider ───────────────────────────────────────────
# Required for Gemini-backed flows
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google OAuth / Calendar / Gmail integration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=756657877266-o3mouo5mo1usml9m64rruqaj0mqhjmah.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Google OAuth is stored in token.json after the local OAuth flow.

# Optional: Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
NTFY_TOPIC=your_ntfy_topic_here

# Optional: Model overrides
CMO_MODEL_ID=gemini-3.5-flash-lite
INTERNAL_MODEL_ID=gemini-3.5-flash-lite
MENTAL_HEALTH_MODEL_ID=gemini-3.5-flash-lite
STRUCTURAL_MODEL_ID=gemini-3.5-flash-lite
ASSISTANT_MODEL_ID=gemini-3.5-flash-lite
BILLING_MODEL_ID=gemini-3.5-flash-lite
COACH_MODEL_ID=gemini-3.5-flash-lite

# Optional: Persistence / local overrides
NEON_DATABASE_URL=your_neon_database_url_here
RUMBLE_CHROMA_PATH=./data/chroma

# ─── Agent Settings ─────────────────────────────────────────
# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

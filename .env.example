# ─── LLM Provider ───────────────────────────────────────────
# Required for OpenAI-based flows
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Gemini key if you want to use Gemini-backed flows
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google OAuth / Calendar / Gmail integration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Optional: Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
NTFY_TOPIC=your_ntfy_topic_here

# Optional: Model overrides
CMO_MODEL_ID=gpt-4o
INTERNAL_MODEL_ID=gpt-4o
MENTAL_HEALTH_MODEL_ID=gpt-4o
STRUCTURAL_MODEL_ID=gpt-4o
ASSISTANT_MODEL_ID=gpt-4o
BILLING_MODEL_ID=gpt-4o
COACH_MODEL_ID=gpt-4o

# Optional: Persistence / local overrides
NEON_DATABASE_URL=your_neon_database_url_here
RUMBLE_CHROMA_PATH=./data/chroma

# ─── Agent Settings ─────────────────────────────────────────
# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
